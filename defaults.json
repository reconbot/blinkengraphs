{
  "description": "Shared defaults for every platform. Each platform deep-merges its own defaults.override.json over this file (rules/defaults.md). Probe intervals are in ms; a Probe's timeout is min(interval, max_timeout_ms).",
  "appearance": "system",
  "dns_query_name": "cloudflare.com",
  "graph_aggregate": "p95",
  "history": {
    "ram_minutes": 15,
    "recent_window_s": 30,
    "rollup_days": 7
  },
  "hop_trace": {
    "full_sweep_every_s": 30,
    "hop_window": 60,
    "max_ttl": 30,
    "reverse_dns": true
  },
  "max_timeout_ms": 1000,
  "primary": {
    "protocol": "icmp",
    "target": "1.1.1.1"
  },
  "probe_group": {
    "dns_ms": 1000,
    "latency_ms": 1000,
    "name": "Default",
    "targets": [
      {
        "dns": false,
        "icmp": true,
        "target": "gateway",
        "tcp": null,
        "trace": false,
        "udp": null
      },
      {
        "dns": true,
        "icmp": true,
        "target": "1.1.1.1",
        "tcp": 443,
        "trace": true,
        "udp": null
      },
      {
        "dns": false,
        "icmp": true,
        "target": "9.9.9.9",
        "tcp": 443,
        "trace": false,
        "udp": null
      },
      {
        "dns": true,
        "icmp": true,
        "target": "2606:4700:4700::1111",
        "tcp": 443,
        "trace": true,
        "udp": null
      },
      {
        "dns": false,
        "icmp": true,
        "target": "2620:fe::fe",
        "tcp": 443,
        "trace": false,
        "udp": null
      },
      {
        "dns": true,
        "icmp": false,
        "target": "system-dns",
        "tcp": null,
        "trace": false,
        "udp": null
      }
    ],
    "trace_ms": 1000
  },
  "readout_aggregate": "p50",
  "system_interval_ms": 1000
}
