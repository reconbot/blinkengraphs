{
  "description": "Shared defaults for every platform. Each platform deep-merges its own defaults.override.json over this file (rules/defaults.md). Probe intervals are in ms; a Probe's timeout is min(interval, max_timeout_ms).",
  "appearance": "system",
  "captive_portal_url": "http://cp.cloudflare.com/generate_204",
  "dns_query_name": "cloudflare.com",
  "graph_aggregate": "p95",
  "history": {
    "archives": [
      {
        "rows": 288,
        "step_s": 300
      },
      {
        "rows": 168,
        "step_s": 3600
      },
      {
        "rows": 365,
        "step_s": 86400
      }
    ],
    "raw_minutes": 120,
    "recent_window_s": 30
  },
  "hop_trace": {
    "full_sweep_every_s": 30,
    "hop_window": 60,
    "max_ttl": 30,
    "reverse_dns": true
  },
  "max_timeout_ms": 1000,
  "primary": {
    "protocol": "icmp",
    "target": "1.1.1.1"
  },
  "probe_group": {
    "dns_ms": 1000,
    "latency_ms": 1000,
    "name": "Default",
    "targets": [
      {
        "dns": false,
        "icmp": true,
        "target": "gateway",
        "tcp": null,
        "trace": false,
        "udp": null
      },
      {
        "dns": true,
        "icmp": true,
        "target": "1.1.1.1",
        "tcp": 443,
        "trace": true,
        "udp": null
      },
      {
        "dns": false,
        "icmp": true,
        "target": "9.9.9.9",
        "tcp": 443,
        "trace": false,
        "udp": null
      },
      {
        "dns": true,
        "icmp": true,
        "target": "2606:4700:4700::1111",
        "tcp": 443,
        "trace": true,
        "udp": null
      },
      {
        "dns": false,
        "icmp": true,
        "target": "2620:fe::fe",
        "tcp": 443,
        "trace": false,
        "udp": null
      },
      {
        "dns": true,
        "icmp": false,
        "target": "system-dns",
        "tcp": null,
        "trace": false,
        "udp": null
      }
    ],
    "trace_ms": 1000
  },
  "public_address": {
    "dns_name": "whoami.cloudflare.com",
    "dns_server": "ns3.cloudflare.com",
    "https_url_ipv4": "https://ipv4.icanhazip.com",
    "https_url_ipv6": "https://ipv6.icanhazip.com",
    "refresh_s": 300
  },
  "readout_aggregate": "p95",
  "system_dns_domain": "microsoft.com",
  "system_interval_ms": 1000
}
