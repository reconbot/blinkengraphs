        "trace": true,
        "udp": null
      },
      {
        "dns": false,
        "icmp": true,
        "target": "8.8.8.8",
        "tcp": 443,
        "trace": false,
        "udp": null
      },
      {
        "dns": true,
        "icmp": false,
        "target": "system-dns",
        "tcp": null,
        "trace": false,
        "udp": null
      }
